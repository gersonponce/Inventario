{
  "info": {
    "name": "Inventario API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API del sistema de Inventario. Orden: 1) Sesión → Obtener CSRF, 2) Sesión → Login. El token CSRF se guarda solo en la variable {{csrf}} y la cookie la maneja Postman. Completa las variables usuario y password de la colección. Documentación: API.md"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://regharina.stardata.pe/api"
    },
    {
      "key": "usuario",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "csrf",
      "value": ""
    },
    {
      "key": "id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Sesión",
      "item": [
        {
          "name": "1. Obtener CSRF",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/sesion",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sesion"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.csrf) pm.collectionVariables.set('csrf', d.csrf);",
                  "pm.test('Respuesta OK', () => pm.response.to.have.status(pm.response.code < 400 ? pm.response.code : 200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Login",
